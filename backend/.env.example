DB_USER=postgres
DB_PASSWORD=cambia_esta_clave
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sig-residuos
SECRET_KEY=genera_una_clave_con_secrets_token_hex
ACCESS_TOKEN_MINUTES=60
# --- Solo en la nube (Vercel + Supabase); en local déjalas comentadas ---
# Cadena del "Transaction pooler" de Supabase (puerto 6543). Si está definida, reemplaza a DB_*
# DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# URL del frontend en Vercel (varias separadas por coma)
# CORS_ORIGINS=https://sig-residuos.vercel.app
# Supabase Storage para las fotos
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_BUCKET=fotos
